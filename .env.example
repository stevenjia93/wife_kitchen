PORT=3000
TRUST_PROXY=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wife_kitchen
POSTGRES_USER=wife_kitchen
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
# 使用阿里云 RDS 时可改为 DATABASE_URL=postgresql://...
# 阿里云百炼华北2（北京）API Key，仅保存在服务端。
DASHSCOPE_API_KEY=replace-with-bailian-api-key
# 可选：使用百炼业务空间专属域名，例如 https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DASHSCOPE_VISION_MODEL=qwen3-vl-plus
# DASHSCOPE_IMAGE_MODEL=qwen-image-3.0-pro
# DASHSCOPE_IMAGE_SIZE=1024*1280
